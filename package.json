{
  "name": "plateplan",
  "version": "3.55.0",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "node scripts/build.js",
    "lint": "node --check server.js && node scripts/test_accessibility_dom.js",
    "ledger": "node scripts/ledger.js",
    "branch:start": "node scripts/git_flow.js start",
    "branch:sync": "node scripts/git_flow.js sync",
    "branch:clean": "node scripts/git_flow.js clean",
    "branch:status": "node scripts/git_flow.js status",
    "test:rules": "firebase emulators:exec --only firestore --project demo-plateplan \"node scripts/test_firestore_rules.js\"",
    "deploy:rules": "npm run test:rules && firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "express": "^4.19.2",
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^15.34.1"
  }
}
