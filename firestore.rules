rules_version = '2';
  service cloud.firestore {
    match /databases/{database}/documents {
      function isHousehold() {
        return request.auth != null
          && request.auth.uid in [
            'mXtYrVi2w5XEZksdCO2jw6tJ1U42',  // Elliott
            '6wwrdUemBBPTIV4Am82NEPNs9Rp2',   // Chloe
            'VGcmLZJBhTN6oTxnNWY1USidYsh1'   // Barrie
          ];
      }
      match /{document=**} {
        allow read, write: if isHousehold();
      }
    }
  }
